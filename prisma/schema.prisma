datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Turma {
  id                 String           @id @default(uuid())
  nome               String
  serie              String
  anoLetivo          Int
  turno              String
  capacidade         Int              @default(25)
  professorTitularId String?
  professorTitular   Colaborador?     @relation(fields: [professorTitularId], references: [id], onDelete: SetNull)
  professores        TurmaProfessor[]
  matriculas         Matricula[]
  comunicados        Comunicado[]
  materiais          MaterialEscolar[]
  livros             LivroEscolar[]
  eventos            EventoEscolar[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Responsavel {
  id          String             @id @default(uuid())
  nome        String
  cpf         String             @unique
  telefone    String
  email       String?
  endereco    String?
  parentesco  String             @default("Responsável")
  alunos      AlunoResponsavel[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Aluno {
  id                 String             @id @default(uuid())
  nome               String
  dataNascimento     DateTime
  genero             String?
  certidaoNascimento String?
  observacoesMedicas String?
  responsaveis       AlunoResponsavel[]
  matriculas          Matricula[]
  solicitacoesFarda   SolicitacaoFarda[]
  respostasFormulario RespostaFormulario[]
  createdAt           DateTime             @default(now())
  updatedAt          DateTime           @updatedAt
}

model AlunoResponsavel {
  id            String      @id @default(uuid())
  alunoId       String
  responsavelId String
  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  ehPrincipal   Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([alunoId, responsavelId])
}

model Matricula {
  id            String               @id @default(uuid())
  codigo        String               @unique
  alunoId       String
  turmaId       String
  anoLetivo     Int
  status        String               @default("ATIVA")
  dataMatricula DateTime             @default(now())
  aluno         Aluno                @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  turma         Turma                @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  documentos    DocumentoMatricula[]
  mensalidades  Mensalidade[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model DocumentoMatricula {
  id          String    @id @default(uuid())
  matriculaId String
  tipo        String
  obrigatorio Boolean   @default(true)
  status      String    @default("PENDENTE")
  dataEntrega DateTime?
  observacao  String?
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matriculaId, tipo])
}

model Mensalidade {
  id             String    @id @default(uuid())
  matriculaId    String
  mesReferencia  Int
  anoReferencia  Int
  vencimento     DateTime
  valor          Float
  status         String    @default("PENDENTE")
  dataPagamento  DateTime?
  operadorPerfil String?   @default("FINANCEIRO")
  observacao     String?
  matricula      Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([matriculaId, mesReferencia, anoReferencia])
}

model Colaborador {
  id              String           @id @default(uuid())
  nome            String
  cpf             String           @unique
  cargo           String
  setor           String           @default("Pedagógico")
  email           String?
  telefone        String?
  especialidade   String?
  ativo           Boolean          @default(true)
  turmas          Turma[]
  turmasAlocadas  TurmaProfessor[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model TurmaProfessor {
  id            String      @id @default(uuid())
  turmaId       String
  colaboradorId String
  turma         Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([turmaId, colaboradorId])
}

model Comunicado {
  id             String   @id @default(uuid())
  titulo         String
  conteudo       String
  publicoAlvo    String   @default("GERAL")
  prioridade     String   @default("NORMAL")
  autorNome      String   @default("Secretaria Escolar")
  autorPerfil    String   @default("SECRETARIA")
  turmaId        String?
  turma          Turma?   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  dataPublicacao DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MaterialEscolar {
  id          String   @id @default(uuid())
  serie       String
  nomeItem    String
  categoria   String   @default("Papelaria / Uso Individual")
  quantidade  Int      @default(1)
  unidade     String   @default("unid.")
  obrigatorio Boolean  @default(true)
  observacao  String?
  turmaId     String?
  turma       Turma?   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LivroEscolar {
  id         String   @id @default(uuid())
  titulo     String
  autor      String?
  editora    String?
  isbn       String?
  disciplina String   @default("Língua Portuguesa")
  serie      String
  origem     String   @default("ADOTADO")
  observacao String?
  turmaId    String?
  turma      Turma?   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SolicitacaoFarda {
  id          String   @id @default(uuid())
  alunoId     String
  tipoPeca    String   @default("Camiseta Diária")
  tamanho     String
  quantidade  Int      @default(1)
  status      String   @default("SOLICITADO")
  solicitante String   @default("Responsável Legal")
  observacao  String?
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormularioModelo {
  id          String               @id @default(uuid())
  titulo      String
  tipo        String               @default("AUTORIZACAO")
  descricao   String
  obrigatorio Boolean              @default(true)
  ativo       Boolean              @default(true)
  respostas   RespostaFormulario[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model RespostaFormulario {
  id              String           @id @default(uuid())
  formularioId    String
  alunoId         String
  responsavelNome String
  decisao         String           @default("AUTORIZADO")
  observacoes     String?
  dataAssinatura  DateTime         @default(now())
  formulario      FormularioModelo @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  aluno           Aluno            @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@unique([formularioId, alunoId])
}

model EventoEscolar {
  id          String    @id @default(uuid())
  titulo      String
  descricao   String
  tipo        String    @default("REUNIAO_PAIS")
  dataInicio  DateTime
  dataFim     DateTime?
  horario     String    @default("08:00")
  local       String    @default("Auditório / Pátio Principal")
  publicoAlvo String    @default("GERAL")
  organizador String    @default("Coordenação Pedagógica")
  perfilAutor String    @default("COORDENACAO")
  turmaId     String?
  turma       Turma?    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
