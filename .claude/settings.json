{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(uname *)",
      "Bash(git --version)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(git remote -v)",
      "Bash(git check-ignore *)",
      "Bash(git init)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null; echo '[KIT] Siga o protocolo do CLAUDE.md §2 antes de qualquer outra coisa. Estado atual do projeto:'; cat ESTADO.md 2>/dev/null || echo 'ESTADO.md nao encontrado: avise o usuario antes de continuar.'"
          }
        ]
      }
    ]
  }
}
